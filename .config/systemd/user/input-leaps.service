[Unit]
Description=Input Leap keyboard/mouse server
PartOf=x-session.target
ConditionFileNotEmpty=%h/.config/InputLeap/input-leap.conf

[Service]
Type=forking
# This unit belongs to x-session.target, not wayland-session.target
ExecStart=/usr/bin/input-leaps --use-x11 --disable-crypto

[Install]
WantedBy=x-session.target
