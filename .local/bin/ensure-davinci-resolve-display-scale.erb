#!/usr/bin/env ruby
<%# Rendered by refresh-dotfiles; kept as ERB so Puppet owns the helper, not Resolve's mutable preferences. %>
# frozen_string_literal: true

require 'rexml/document'
require 'rexml/xpath'

DISPLAY_SCALE_ELEMENT = %r{<DisplayScale>([^<]*)</DisplayScale>}
DISPLAY_SCALE_OPEN = /<DisplayScale(?=[\s>])/
DISPLAY_SCALE_CLOSE = %r{</DisplayScale\s*>}

def resolve_running?
  return false unless File.directory?('/proc')

  Dir.glob('/proc/[0-9]*/comm').any? do |path|
    File.read(path).chomp.casecmp('resolve').zero?
  rescue Errno::EACCES, Errno::ENOENT, Errno::ESRCH
    false
  end
end

def fail_closed(message)
  warn "ensure-davinci-resolve-display-scale: #{message}"
  exit 1
end

require_stopped = ARGV.delete('--require-stopped')
fail_closed('usage: ensure-davinci-resolve-display-scale [--require-stopped] PATH') unless ARGV.length == 1
fail_closed('DaVinci Resolve is running; refusing to edit its preferences') if require_stopped && resolve_running?

path = ARGV.fetch(0)
begin
  File.open(path, File::RDWR | File::NOFOLLOW) do |config|
    config.flock(File::LOCK_EX)
    stat = config.stat
    fail_closed("not a regular file: #{path}") unless stat.file?

    original = config.read

    begin
      document = REXML::Document.new(original)
    rescue REXML::ParseException => e
      fail_closed("malformed XML in #{path}: #{e.message.lines.first&.strip}")
    end

    elements = REXML::XPath.match(document, '//DisplayScale')
    fail_closed("expected exactly one DisplayScale element in #{path}, found #{elements.length}") unless elements.length == 1

    lexical_match = original.match(DISPLAY_SCALE_ELEMENT)
    unambiguous = original.scan(DISPLAY_SCALE_OPEN).length == 1 &&
                  original.scan(DISPLAY_SCALE_CLOSE).length == 1 &&
                  lexical_match && lexical_match[1] == elements.first.text.to_s
    fail_closed("DisplayScale element has an unsupported or ambiguous representation in #{path}") unless unambiguous

    exit 0 if lexical_match[0] == '<DisplayScale>200</DisplayScale>'

    updated = original.sub(DISPLAY_SCALE_ELEMENT, '<DisplayScale>200</DisplayScale>')

    begin
      updated_document = REXML::Document.new(updated)
      updated_elements = REXML::XPath.match(updated_document, '//DisplayScale')
    rescue REXML::ParseException => e
      fail_closed("replacement would produce malformed XML in #{path}: #{e.message.lines.first&.strip}")
    end
    unless updated_elements.length == 1 && updated_elements.first.text == '200'
      fail_closed("replacement did not produce exactly one 200 DisplayScale element in #{path}")
    end

    begin
      path_stat = File.lstat(path)
      same_target = path_stat.file? && path_stat.dev == stat.dev && path_stat.ino == stat.ino
    rescue Errno::ENOENT
      same_target = false
    end
    fail_closed("#{path} changed while it was being validated; refusing to edit") unless same_target
    fail_closed('DaVinci Resolve started while preferences were being validated; refusing to edit') if require_stopped && resolve_running?

    begin
      config.rewind
      config.write(updated)
      config.truncate(updated.bytesize)
      config.flush
      config.fsync

      if require_stopped && resolve_running?
        config.rewind
        config.write(original)
        config.truncate(original.bytesize)
        config.flush
        config.fsync
        fail_closed('DaVinci Resolve started during the edit; restored the original preferences')
      end
    rescue SystemCallError => e
      begin
        config.rewind
        config.write(original)
        config.truncate(original.bytesize)
        config.flush
        config.fsync
      rescue SystemCallError
        # Preserve the original write error when best-effort rollback also fails
      end
      fail_closed("could not update #{path}: #{e.message}")
    end
  end
rescue Errno::ENOENT
  exit 0
rescue Errno::ELOOP
  fail_closed("refusing to follow symbolic link: #{path}")
rescue Errno::EACCES, Errno::EISDIR => e
  fail_closed("cannot open #{path}: #{e.message}")
end
